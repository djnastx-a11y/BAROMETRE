><div class="alert-dot"></div><div><b>${p.name}</b><small>${p.supplier}</small></div></div><div class="qty">${p.qty} ${p.unit}</div></div>`).join(''):`<div class="alert"><div><b>Aucune alerte</b><small>Stock au-dessus des seuils.</small></div></div>`}
  </div>
 </div>
 </div>`
}

function planningPage(){
 const monday=mondayOf(now),days=[0,1,2,3,4,5,6].map(n=>addDays(monday,n));
 return `<div class="page active">
 <div class="page-top"><div><h2>Planning</h2><p>Semaine du ${fmt(days[0])} au ${fmt(days[6])}</p></div>${admin()?`<button class="btn gold" onclick="openShift()">+ Shift</button>`:''}</div>
 <div class="seg"><button>Jour</button><button class="active">Semaine</button><button>Mois</button></div>
 <div class="planner-scroll"><div class="planner">
  <div class="ph">Équipe</div>${days.map(d=>`<div class="ph">${fmt(d)}</div>`).join('')}
  ${state.users.filter(u=>u.active).map(u=>`
   <div class="name-cell"><b>${u.name}</b><span>${role(u.role)}</span></div>
   ${days.map(d=>{const ds=iso(d);const ss=state.shifts.filter(s=>s.userId===u.id&&s.date===ds);return `<div class="day-cell" onclick="${admin()?`openShift('${u.id}','${ds}')`:''}">${ss.map(s=>`<div class="shift ${s.type==='absence'?'absence':u.role==='extra'?'extra':'work'}"><b>${s.type==='absence'?'ABSENCE':`${s.start} · ${s.end}`}</b><small>${s.note||''}</small></div>`).join('')}</div>`}).join('')}
  `).join('')}
 </div></div>
 </div>`
}

function stockPage(){
 const value=state.stock.reduce((a,p)=>a+(+p.qty*+p.buy),0);
 return `<div class="page active">
 <div class="page-top"><div><h2>Stock</h2><p>Inventaire, seuils et commandes</p></div><div>${stockWrite()?`<button class="btn soft" onclick="openInventory()">Inventaire</button>`:''} ${admin()?`<button class="btn gold" onclick="openProduct()">+ Produit</button>`:''}</div></div>
 <div class="stats" style="margin-bottom:12px">
  <div class="stat"><span>Produits</span><strong>${state.stock.length}</strong><small>références</small></div>
  <div class="stat"><span>Alertes</span><strong>${state.stock.filter(p=>+p.qty<=+p.min).length}</strong><small>sous seuil</small></div>
  <div class="stat"><span>Valeur</span><strong>${value.toFixed(0)}€</strong><small>achat estimé</small></div>
 </div>
 <div class="table-wrap"><table><thead><tr><th>Produit</th><th>Stock</th><th>Seuil</th><th>Fournisseur</th><th>À commander</th><th></th></tr></thead><tbody>
  ${state.stock.map(p=>`<tr><td><b>${p.name}</b><small>${p.category}</small></td><td class="${+p.qty<=+p.min?'stock-low':'stock-ok'}">${p.qty} ${p.unit}</td><td>${p.min}</td><td>${p.supplier}</td><td>${Math.max(0,+p.min*2-+p.qty)} ${p.unit}</td><td>${stockWrite()?`<button class="mini" onclick="adjustStock('${p.id}')">Ajuster</button>`:''}</td></tr>`).join('')}
 </tbody></table></div>
 </div>`
}

function teamPage(){
 return `<div class="page active">
 <div class="page-top"><div><h2>Équipe</h2><p>Admins, employés et extras</p></div>${admin()?`<button class="btn gold" onclick="openUser()">+ Ajouter</button>`:''}</div>
 <div class="people-grid">${state.users.map(u=>`<div class="person-card"><div class="person-main"><div class="person-avatar ${u.role==='extra'?'extra':''}">${initials(u.name)}</div><div><b>${u.name}</b><span>${u.active?'Actif':'Inactif'}</span></div></div><span class="role-pill ${u.role}">${role(u.role)}</span></div>`).join('')}</div>
 </div>`
}

function morePage(){
 const mine=state.requests.filter(r=>admin()||r.userId===me().id);
 return `<div class="page active">
 <div class="page-top"><div><h2>Demandes</h2><p>Disponibilités, absences et remplacements</p></div><button class="btn gold" onclick="openRequest()">+ Demande</button></div>
 <div class="more-grid">
  <div>
   <div class="section-head"><div><h2>En cours</h2><span>${mine.length} demande(s)</span></div></div>
   <div class="panel">${mine.length?mine.map(r=>{const u=state.users.find(x=>x.id===r.userId);return `<div class="row"><div><b>${u?.name}</b><small>${r.kind} · ${r.date}</small></div><span class="role-pill">${r.status}</span></div>`}).join(''):`<div class="row"><small>Aucune demande.</small></div>`}</div>
  </div>
  <div>
   <div class="section-head"><div><h2>Commandes</h2><span>Selon les seuils</span></div></div>
   <div class="panel">${['COZIGOU','METRO'].map(s=>{const arr=state.stock.filter(p=>p.supplier===s&&+p.qty<=+p.min);return `<div class="row"><div><b>${s}</b><small>${arr.length?arr.map(p=>p.name).join(', '):'Rien à commander'}</small></div><div class="time">${arr.length}</div></div>`}).join('')}</div>
  </div>
 </div>
 </div>`
}

function nav(){
 const tabs=[['home','Accueil',icons.home],['planning','Planning',icons.planning],['stock','Stock',icons.stock],['team','Équipe',icons.team],['more','Plus',icons.more]];
 return `<div class="bottom-nav">${tabs.map(([k,l,i])=>`<button class="nav-btn ${view===k?'active':''}" onclick="view='${k}';render()">${i}<span>${l}</span></button>`).join('')}</div>`
}

function openShift(userId='',date=''){
 modal=`<div class="modal-back" onclick="if(event.target===this)closeModal()"><div class="modal"><div class="modal-head"><h3>Nouveau shift</h3><button class="mini" onclick="closeModal()">Fermer</button></div><div class="modal-body">
 <form class="form-grid" onsubmit="saveShift(event)">
  <label>Personne<select name="userId">${state.users.filter(u=>u.active).map(u=>`<option value="${u.id}" ${u.id===userId?'selected':''}>${u.name}</option>`).join('')}</select></label>
  <label>Date<input type="date" name="date" value="${date||iso(now)}"></label>
  <label>Début<input type="time" name="start" value="18:00"></label>
  <label>Fin<input type="time" name="end" value="01:00"></label>
  <label>Type<select name="type"><option value="work">Travail</option><option value="absence">Absence</option></select></label>
  <label>Note<input name="note" placeholder="Bar, salle, renfort..."></label>
  <div class="full"><button class="btn gold">Enregistrer</button></div>
 </form></div></div></div>`;render()
}
function saveShift(e){e.preventDefault();const f=new FormData(e.target);state.shifts.push({id:uid(),userId:f.get('userId'),date:f.get('date'),start:f.get('start'),end:f.get('end'),type:f.get('type'),note:f.get('note')});modal='';save()}

function openUser(){
 modal=`<div class="modal-back" onclick="if(event.target===this)closeModal()"><div class="modal"><div class="modal-head"><h3>Ajouter à l’équipe</h3><button class="mini" onclick="closeModal()">Fermer</button></div><div class="modal-body">
 <form class="form-grid" onsubmit="saveUser(event)"><label>Prénom<input name="name" required></label><label>Rôle<select name="role"><option value="employee">Employé</option><option value="extra">Extra</option><option value="admin">Admin</option></select></label><div class="full"><button class="btn gold">Ajouter</button></div></form>
 </div></div></div>`;render()
}
function saveUser(e){e.preventDefault();const f=new FormData(e.target);state.users.push({id:uid(),name:String(f.get('name')).toUpperCase(),role:f.get('role'),active:true});modal='';save()}

function openProduct(){
 modal=`<div class="modal-back" onclick="if(event.target===this)closeModal()"><div class="modal"><div class="modal-head"><h3>Nouveau produit</h3><button class="mini" onclick="closeModal()">Fermer</button></div><div class="modal-body">
 <form class="form-grid" onsubmit="saveProduct(event)">
  <label>Produit<input name="name" required></label><label>Catégorie<select name="category"><option>Bières</option><option>Alcools</option><option>Softs</option><option>Vins</option><option>Consommables</option></select></label>
  <label>Unité<select name="unit"><option>bouteilles</option><option>cartons</option><option>fûts</option><option>packs</option><option>unités</option></select></label>
  <label>Quantité<input type="number" step=".01" name="qty" value="0"></label><label>Seuil<input type="number" step=".01" name="min" value="1"></label>
  <label>Fournisseur<select name="supplier"><option>COZIGOU</option><option>METRO</option><option>AUTRE</option></select></label>
  <label>Prix achat<input type="number" step=".01" name="buy" value="0"></label>
  <div class="full"><button class="btn gold">Ajouter</button></div>
 </form></div></div></div>`;render()
}
function saveProduct(e){e.preventDefault();const f=new FormData(e.target);state.stock.push({id:uid(),name:f.get('name'),category:f.get('category'),unit:f.get('unit'),qty:+f.get('qty'),min:+f.get('min'),supplier:f.get('supplier'),buy:+f.get('buy')});modal='';save()}

function adjustStock(id){
 const p=state.stock.find(x=>x.id===id);
 modal=`<div class="modal-back" onclick="if(event.target===this)closeModal()"><div class="modal"><div class="modal-head"><h3>${p.name}</h3><button class="mini" onclick="closeModal()">Fermer</button></div><div class="modal-body">
 <form class="form-grid" onsubmit="saveAdjust(event,'${id}')">
  <label>Nouvelle quantité<input type="number" step=".01" name="qty" value="${p.qty}"></label>
  <label>Motif<select name="reason"><option>Inventaire</option><option>Entrée</option><option>Sortie</option><option>Casse</option><option>Perte</option></select></label>
  <div class="full"><button class="btn gold">Valider</button></div>
 </form></div></div></div>`;render()
}
function saveAdjust(e,id){e.preventDefault();const f=new FormData(e.target);const p=state.stock.find(x=>x.id===id);const before=+p.qty;p.qty=+f.get('qty');state.stockLog.push({id:uid(),productId:id,before,after:p.qty,reason:f.get('reason'),at:new Date().toISOString(),userId:me().id});modal='';save()}

function openInventory(){
 modal=`<div class="modal-back" onclick="if(event.target===this)closeModal()"><div class="modal"><div class="modal-head"><h3>Inventaire express</h3><button class="mini" onclick="closeModal()">Fermer</button></div><div class="modal-body">
 <form onsubmit="saveInventory(event)">${state.stock.map(p=>`<label style="margin-bottom:10px">${p.name}<input type="number" step=".01" name="${p.id}" value="${p.qty}"></label>`).join('')}<button class="btn gold">Enregistrer l’inventaire</button></form>
 </div></div></div>`;render()
}
function saveInventory(e){e.preventDefault();const f=new FormData(e.target);state.stock.forEach(p=>{const before=+p.qty,after=+f.get(p.id);if(before!==after){p.qty=after;state.stockLog.push({id:uid(),productId:p.id,before,after,reason:'Inventaire',at:new Date().toISOString(),userId:me().id})}});modal='';save()}

function openRequest(){
 modal=`<div class="modal-back" onclick="if(event.target===this)closeModal()"><div class="modal"><div class="modal-head"><h3>Nouvelle demande</h3><button class="mini" onclick="closeModal()">Fermer</button></div><div class="modal-body">
 <form class="form-grid" onsubmit="saveRequest(event)">
  ${admin()?`<label>Personne<select name="userId">${state.users.map(u=>`<option value="${u.id}">${u.name}</option>`).join('')}</select></label>`:''}
  <label>Type<select name="kind"><option>Disponibilité</option><option>Indisponibilité</option><option>Absence</option><option>Remplacement</option></select></label>
  <label>Date<input type="date" name="date" value="${iso(now)}"></label>
  <label class="full">Commentaire<textarea name="note" rows="3"></textarea></label>
  <div class="full"><button class="btn gold">Envoyer</button></div>
 </form></div></div></div>`;render()
}
function saveRequest(e){e.preventDefault();const f=new FormData(e.target);state.requests.push({id:uid(),userId:admin()?f.get('userId'):me().id,kind:f.get('kind'),date:f.get('date'),note:f.get('note'),status:admin()?'accepted':'pending'});modal='';save()}

function closeModal(){modal='';render()}

function render(){
 const root=document.getElementById('root');
 if(!state.currentUserId){root.innerHTML=loginScreen();return}
 let body=view==='home'?homePage():view==='planning'?planningPage():view==='stock'?stockPage():view==='team'?teamPage():morePage();
 root.innerHTML=`<div class="app-shell">${header()}<div class="content">${body}</div>${nav()}${modal||''}</div>`;
}
render();
</script>
</body>
</html>
