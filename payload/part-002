 const pending=state.requests.filter(r=>r.status==='pending');
 return `<div class="page active"><div class="section"><div class="stats"><div class="stat"><span>Équipe</span><strong>${shifts.length}</strong><small>aujourd’hui</small></div><div class="stat"><span>Stock bas</span><strong>${low.length}</strong><small>alertes</small></div><div class="stat"><span>Demandes</span><strong>${pending.length}</strong><small>en attente</small></div></div></div><div class="section"><div class="section-head"><div><h2>Aujourd’hui</h2><span>Équipe planifiée</span></div><button class="link-btn" onclick="view='planning';render()">Voir tout</button></div><div class="panel">
   ${shifts.map(s=>{const u=state.users.find(x=>x.id===s.userId);return `<div class="row"><div class="row-left"><div class="person-avatar ${u?.role==='extra'?'extra':''}">${initials(u?.name||'?')}</div><div><b>${u?.name||'?'}</b><small>${s.note||role(u?.role)}</small></div></div><div class="time">${s.start} · ${s.end}</div></div>`}).join('') || `<div class="row"><small>Aucun shift aujourd’hui.</small></div>`}
  </div></div><div class="section"><div class="section-head"><div><h2>Stock à surveiller</h2><span>Seuil minimum atteint</span></div><button class="link-btn" onclick="view='stock';render()">Voir stock</button></div><div class="panel">
   ${low.length?low.map(p=>`<div class="alert"><div class="alert-left"><div class="alert-dot"></div><div><b>${p.name}</b><small>${p.supplier}</small></div></div><div class="qty">${p.qty} ${p.unit}</div></div>`).join(''):`<div class="alert"><div><b>Aucune alerte</b><small>Stock au-dessus des seuils.</small></div></div>`}
  </div></div></div>`
}

function planningPage(){
 const monday=mondayOf(now),days=[0,1,2,3,4,5,6].map(n=>addDays(monday,n));
 return `<div class="page active"><div class="page-top"><div><h2>Planning</h2><p>Semaine du ${fmt(days[0])} au ${fmt(days[6])}</p></div>${admin()?`<button class="btn gold" onclick="openShift()">+ Shift</button>`:''}</div><div class="seg"><button>Jour</button><button class="active">Semaine</button><button>Mois</button></div><div class="planner-scroll"><div class="planner"><div class="ph">Équipe</div>${days.map(d=>`<div class="ph">${fmt(d)}</div>`).join('')}
  ${state.users.filter(u=>u.active).map(u=>`
   <div class="name-cell"><b>${u.name}</b><span>${role(u.role)}</span></div>
   ${days.map(d=>{const ds=iso(d);const ss=state.shifts.filter(s=>s.userId===u.id&&s.date===ds);return `<div class="day-cell" onclick="${admin()?`openShift('${u.id}','${ds}')`:''}">${ss.map(s=>`<div class="shift ${s.type==='absence'?'absence':u.role==='extra'?'extra':'work'}"><b>${s.type==='absence'?'ABSENCE':`${s.start} · ${s.end}`}</b><small>${s.note||''}</small></div>`).join('')}</div>`}).join('')}
  `).join('')}
 </div></div></div>`
}

