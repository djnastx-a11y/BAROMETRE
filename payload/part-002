function save(){localStorage.setItem(KEY,JSON.stringify(state));render()}
function me(){return state.users.find(u=>u.id===state.currentUserId)}
function admin(){return me()?.role==='admin'}
function stockWrite(){return ['admin','employee'].includes(me()?.role)}
function role(r){return r==='admin'?'ADMIN':r==='employee'?'EMPLOYÉ':'EXTRA'}
function initials(n){return n.split(' ').map(x=>x[0]).join('').slice(0,2)}
function login(id){state.currentUserId=id;save()}
function logout(){state.currentUserId=null;save()}

